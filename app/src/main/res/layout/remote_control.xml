<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121">

    <TextView
        android:id="@+id/bt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="未连接"
        android:textColor="#FF5722"
        android:textSize="20sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:layout_below="@+id/bt_status">

        <ImageView
            android:id="@+id/home_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_home"
            android:padding="10dp"
            android:scaleType="centerInside"/>

        <ImageView
            android:id="@+id/setting_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_setting"
            android:padding="10dp"
            android:scaleType="centerInside"/>

        <ImageView
            android:id="@+id/number_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_number"
            android:padding="10dp"
            android:scaleType="centerInside"/>

        <ImageView
            android:id="@+id/power_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_power"
            android:padding="10dp"
            android:scaleType="centerInside"/>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_below="@+id/bt_status">

        <TextView
            android:id="@+id/device_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:clickable="true"
            android:padding="20dp"
            android:background="@drawable/shape_rounded"
            android:text="15451564215"
            android:textSize="18sp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/direction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:padding="10dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/up_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_up"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">


                <ImageView
                    android:id="@+id/left_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_left"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/ok_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_ok"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/right_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_right"
                    android:scaleType="centerCrop"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/down_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_down"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"/>

        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/number"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="20dp"
        android:layout_below="@+id/direction"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_icon"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"/>

        <ImageView
            android:id="@+id/voice_icon"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:src="@drawable/ic_voice"
            android:scaleType="fitCenter"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1" >

            <ImageView
                android:id="@+id/volume_up"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_volume_up"
                android:scaleType="fitCenter"/>

            <View
                android:layout_width="wrap_content"
                android:layout_height="20dp" />

            <ImageView
                android:id="@+id/volume_down"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_volume_down"
                android:scaleType="fitCenter"/>

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
